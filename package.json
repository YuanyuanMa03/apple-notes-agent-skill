{
  "name": "apple-notes-agent-skill",
  "version": "0.1.0",
  "description": "Install Apple Notes capabilities into Claude, Codex and other local agents with one prompt",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/YuanyuanMa03/apple-notes-agent-skill.git"
  },
  "files": [
    "skills",
    "scripts",
    "install.sh",
    "INSTALL.md",
    "README.md",
    "LICENSE",
    "NOTICE",
    "docs/usage.md"
  ],
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "check": "node scripts/check-package.mjs",
    "format:check": "prettier --check 'skills/**/*.mjs' 'scripts/*.mjs' 'tests/*.mjs'",
    "test:live": "node scripts/live-acceptance.mjs",
    "pack:skill": "node scripts/package-skill.mjs"
  },
  "devDependencies": {
    "prettier": "3.9.10"
  }
}
